# termbox.env — generated by termbox init
# DO NOT EDIT
#
# This file is responsible for most of
# the outcome termbox provide.
# It allows termbox shell-sourced features
# to work without the need of running `termbox`

# if the installation was a full clone, this value is set
export TERMBOX_HOME="${TERMBOX_HOME:-$HOME/Developer/termbox}"

# termbox supportive settings
export TERMBOX_DEV_FOLDER="${TERMBOX_DEV_FOLDER:-$HOME/Developer}"
export NOTE_FOLDER="${NOTE_FOLDER:-$HOME/Developer/notes}"

# termbox XDG locations
export TERMBOX_CONFIG_DIR="${TERMBOX_CONFIG_DIR:-$XDG_CONFIG_HOME/termbox}"
export TERMBOX_DATA_DIR="${TERMBOX_DATA_DIR:-$XDG_DATA_HOME/termbox}"
export TERMBOX_CACHE_DIR="${TERMBOX_CACHE_DIR:-$XDG_CACHE_HOME/termbox}"

# termbox shell features settings.
# In case of issues,
# update with `termbox sync`
export THEME_NAME="catppuccin_mocha"
export TERMBOX_SHOW_SCREEN="${TERMBOX_SHOW_SCREEN:-true}"
